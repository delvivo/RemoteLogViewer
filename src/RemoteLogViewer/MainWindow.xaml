<Window x:Class="RemoteLogViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Log Viewer" Height="720" Width="1280" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="120" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="4">
            <TextBlock DockPanel.Dock="Top" Text="Sessioni salvate" FontWeight="SemiBold" Margin="2,0,0,4" />
            <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,4,0,0">
                <Button Content="Avvia" Margin="1" Click="Start_Click" />
                <Button Content="Nuova" Margin="1" Click="New_Click" />
                <Button Content="Modifica" Margin="1" Click="Edit_Click" />
                <Button Content="Duplica" Margin="1" Click="Duplicate_Click" />
                <Button Content="Elimina" Margin="1" Click="Delete_Click" />
            </UniformGrid>
            <ListBox x:Name="SessionList" MouseDoubleClick="SessionList_DoubleClick" KeyDown="SessionList_KeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2" ToolTip="{Binding FullPath}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FullPath}" Foreground="Gray" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

        <DockPanel Grid.Column="2">
            <ToolBar DockPanel.Dock="Top">
                <ToggleButton x:Name="SideBySideButton" Content="Affianca" Checked="SideBySide_Click" Unchecked="SideBySide_Click" ToolTip="Mostra tutte le sessioni aperte contemporaneamente" />
            </ToolBar>
            <Grid>
                <TabControl x:Name="Tabs" />
                <UniformGrid x:Name="SideBySideGrid" Visibility="Collapsed" />
                <TextBlock x:Name="EmptyHint" Text="Doppio click su una sessione salvata per avviarla, oppure crea una Nuova sessione."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
