<Window x:Class="RemoteLogViewer.TextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <Label x:Name="Prompt" Target="{Binding ElementName=Input}" Padding="0,0,0,4" />
        <TextBox x:Name="Input" Padding="2" />
        <TextBlock x:Name="Error" Foreground="Red" TextWrapping="Wrap" Margin="0,4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Padding="16,3" Margin="4,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Annulla" Padding="10,3" Margin="4,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
