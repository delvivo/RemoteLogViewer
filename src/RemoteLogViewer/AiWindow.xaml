<Window x:Class="RemoteLogViewer.AiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RemoteLogViewer"
        Title="{local:T 'Analisi IA'}" Width="1000" Height="700" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Activated="Window_Activated" Closed="Window_Closed">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="120" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="{local:T 'Schede da analizzare'}" FontWeight="Bold" Margin="0,0,0,4" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TabList" AutomationProperties.Name="{local:T 'Schede da analizzare'}" />
            </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" Margin="4,0" HorizontalAlignment="Stretch" />

        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="{local:T 'Strumento'}" Width="70" VerticalAlignment="Center" />
                    <ComboBox x:Name="ToolBox" Width="190" DisplayMemberPath="Name" SelectionChanged="Tool_Changed"
                              AutomationProperties.Name="{local:T 'Strumento'}" />
                    <Button DockPanel.Dock="Right" Content="{local:T 'Ripristina'}" Width="80" Margin="4,0,0,0" Click="Reset_Click"
                            ToolTip="{local:T 'Torna al comando predefinito dello strumento'}" />
                    <TextBox x:Name="CommandBox" Margin="8,0,0,0" VerticalContentAlignment="Center" FontFamily="Consolas" Padding="2"
                             LostFocus="Command_LostFocus" TextChanged="Input_Changed"
                             ToolTip="{local:T 'Comando eseguito con cmd: riceve prompt e log come input e scrive la risposta in output'}"
                             AutomationProperties.Name="{local:T 'Comando'}" />
                </DockPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="{local:T 'Prompt'}" Width="70" VerticalAlignment="Center" />
                    <ComboBox x:Name="PresetBox" Width="190" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectionChanged="Preset_Changed"
                              AutomationProperties.Name="{local:T 'Prompt preimpostato'}" />
                </DockPanel>
                <TextBox x:Name="PromptBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         TextChanged="Input_Changed" AutomationProperties.Name="{local:T 'Prompt'}" />
                <TextBlock Margin="0,4" TextWrapping="Wrap" Foreground="#8A5A00"
                           Text="{local:T '⚠ I log selezionati vengono inviati allo strumento IA scelto e, per gli strumenti online, al relativo servizio.'}" />
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="StartButton" Content="{local:T 'Avvia'}" Width="80" IsEnabled="False" Click="Start_Click" />
                    <Button x:Name="CancelButton" Content="{local:T 'Annulla'}" Width="80" Margin="4,0,0,0" IsEnabled="False" Click="Cancel_Click" />
                    <TextBlock x:Name="StatusLabel" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button x:Name="CopyButton" Content="{local:T 'Copia'}" Width="80" IsEnabled="False" Click="Copy_Click" />
                <Button x:Name="OpenButton" Content="{local:T 'Apri formattato'}" Padding="8,0" Margin="4,0,0,0" IsEnabled="False" Click="Open_Click"
                        ToolTip="{local:T 'Apre la risposta formattata nel browser'}" />
                <Button x:Name="ExportButton" Content="{local:T 'Esporta…'}" Width="90" Margin="4,0,0,0" IsEnabled="False" Click="Export_Click"
                        ToolTip="{local:T 'Salva il report in Markdown o HTML'}" />
            </StackPanel>

            <TextBox x:Name="OutputBox" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{local:T 'Risposta'}" />
        </DockPanel>
    </Grid>
</Window>
